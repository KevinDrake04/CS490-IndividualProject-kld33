{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Flask",
      "type": "shell",
      "command": "py",
      "args": ["server.py"],
      "options": { "cwd": "${workspaceFolder}/flask-server" },
      "presentation": { "panel": "dedicated", "group": "backend", "reveal": "always" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: React",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": { "cwd": "${workspaceFolder}/my-app" },
      "presentation": { "panel": "dedicated", "group": "frontend", "reveal": "always" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Start both",
      "dependsOn": ["Backend: Flask", "Frontend: React"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
